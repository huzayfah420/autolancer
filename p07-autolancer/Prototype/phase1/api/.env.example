# Copy to .env (gitignored) and fill in. Never commit real values.

# SQLAlchemy URL. Local default is SQLite; for Supabase use the Session pooler URI from
# Project Settings > Database, with the psycopg driver:
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./autolancer.db

# Supabase project URL (used to fetch JWKS for asymmetric JWT signing keys).
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy JWT secret (Project Settings > API > JWT Settings). Leave empty to use JWKS instead.
SUPABASE_JWT_SECRET=

# Where the API reaches the marketplace simulator. Locally the API serves it at /sim.
SIMULATOR_URL=http://localhost:8000/sim

# LiteLLM model name, or "mock" for deterministic fake output (no key needed).
LLM_MODEL=mock
LLM_TIMEOUT_SECONDS=60
# Provider key read by LiteLLM for the chosen model, e.g. for deepseek/deepseek-chat:
# DEEPSEEK_API_KEY=

# Daily AI cap (USD) used only until the owner saves their first policy.
DEFAULT_DAILY_AI_CAP_USD=0.50

# Comma-separated browser origins allowed to call the API (the hub URL).
CORS_ORIGINS=http://localhost:3000
