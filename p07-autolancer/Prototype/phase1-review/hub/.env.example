# Copy to .env.local (gitignored). These are public browser values, but keep real ones out of git.

# Base URL of the Autolancer API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and anon/publishable key (Project Settings > API). Used only for sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
